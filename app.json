{
  "expo": {
    "name": "Desafio2DPS",
    "slug": "Desafio2DPS",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "desafio2dps",
    "userInterfaceStyle": "automatic",
    "ios": {
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
